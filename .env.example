# Set environment variables in the shell before starting the backend.
# Spring Boot does not load this file automatically.
# JWT_SECRET: Base64 of at least 32 cryptographically random bytes. No default.
JWT_SECRET=
# Optional PostgreSQL configuration (otherwise a local H2 file is used).
# DB_URL=jdbc:postgresql://localhost:5432/gamenews
# DB_USERNAME=gamenews
# DB_PASSWORD=
# Optional one-time administrator creation. Set both; remove after creation.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
